@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(keel)
find_dependency(keel_compress)

include("${CMAKE_CURRENT_LIST_DIR}/keel_matTargets.cmake")
if(NOT TARGET keel::mat AND TARGET keel::keel_mat)
    add_library(keel::mat ALIAS keel::keel_mat)
endif()
check_required_components(keel_mat)
